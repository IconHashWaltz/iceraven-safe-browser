+
+package org.mozilla.fenix.nopriv
+
+/**
+ * DNS-over-HTTPS resolver that this build always uses, so the content filter applies
+ * regardless of the phone's or the Wi-Fi network's DNS settings.
+ *
+ * Cloudflare for Families (malware + adult content blocking). To use another filter,
+ * change this single URL.
+ */
+object FilterDns {
+    const val DOH_URI = "https://family.cloudflare-dns.com/dns-query"
+}
diff --git a/app/src/main/java/org/mozilla/fenix/nopriv/NoPrivateTabsMiddleware.kt b/app/src/main/java/org/mozilla/fenix/nopriv/NoPrivateTabsMiddleware.kt
new file mode 100644
index 0000000..fb63d13
--- /dev/null
+++ b/app/src/main/java/org/mozilla/fenix/nopriv/NoPrivateTabsMiddleware.kt
@@ -0,0 +1,32 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+package org.mozilla.fenix.nopriv
+
+import mozilla.components.browser.state.action.BrowserAction
+import mozilla.components.browser.state.action.TabListAction
+import mozilla.components.browser.state.state.BrowserState
+import mozilla.components.lib.state.Middleware
+import mozilla.components.lib.state.Store
+
+/**
+ * Safety net: closes every private tab as soon as one exists in the [BrowserState],
+ * no matter which code path created it.
+ */
+class NoPrivateTabsMiddleware : Middleware<BrowserState, BrowserAction> {
+
+    override fun invoke(
+        store: Store<BrowserState, BrowserAction>,
+        next: (BrowserAction) -> Unit,
+        action: BrowserAction,
+    ) {
+        next(action)
+
+        if (action !is TabListAction.RemoveAllPrivateTabsAction &&
+            store.state.tabs.any { it.content.private }
+        ) {
+            store.dispatch(TabListAction.RemoveAllPrivateTabsAction)
+        }
+    }
+}
